<Window x:Class="LaptopQaUsbBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laptop QA USB Drive Builder" Width="1360" Height="820"
        Icon="Assets/app-icon.ico"
        MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" Foreground="#17272D"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Slate" Color="#687F87" />
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Slate}"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="#FBFCFA"/><Setter Property="BorderBrush" Value="#9EB1B7"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FCFDFB"/><Setter Property="BorderBrush" Value="#9BB0B7"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="26"/><Setter Property="Padding" Value="24,18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#52666D" BlurRadius="16" ShadowDepth="6" Opacity="0.23"/></Setter.Value></Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#526970"/><Setter Property="FontSize" Value="12"/></Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Placement" Value="Mouse"/><Setter Property="HorizontalOffset" Value="12"/><Setter Property="VerticalOffset" Value="10"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
                <Border Background="#F8FBF9" BorderBrush="#9BB0B7" BorderThickness="1" CornerRadius="10" Padding="12,9">
                    <Border.Effect><DropShadowEffect Color="#52666D" BlurRadius="10" ShadowDepth="3" Opacity="0.22"/></Border.Effect>
                    <ContentPresenter TextElement.Foreground="#17272D"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F4F5F1" CornerRadius="28" BorderBrush="#E0E5E2" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="108"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
            <Grid x:Name="TitleBar" Grid.Row="0" Margin="28,18,28,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ConfigButton" Content="&#x2699;" Click="Config_Click" FontSize="24" Foreground="#17272D" Background="Transparent" Width="40" Padding="2" Margin="0,0,8,0" ToolTip="Partition settings"/>
                        <TextBlock Text="Laptop QA" FontSize="32" FontWeight="Light"/>
                        <TextBlock Text=" USB Drive Builder" FontSize="32" FontWeight="Light" Foreground="#61747B"/>
                    </StackPanel>
                    <TextBlock Text="Prepare standardized support media safely and consistently" Margin="0,2,0,0" Foreground="#526970" FontSize="13"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#D7F3E5" BorderBrush="#74D3A2" BorderThickness="1" CornerRadius="22" Height="46" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderStatus" Text="Ready" Foreground="#147A4B" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="-" Click="Minimize_Click" FontSize="22" Foreground="#17272D" Background="Transparent" Width="42" Padding="4"/>
                    <Button Content="x" Click="Close_Click" FontSize="18" Foreground="#17272D" Background="Transparent" Width="42" Padding="4"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="42,0,42,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,10"><Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="1. Select USB Drive" Margin="0,0,0,7"/>
                            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                <ListBox x:Name="DiskPicker" Height="66" SelectionMode="Multiple" SelectionChanged="DiskPicker_SelectionChanged"
                                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="DriveCard" Background="#EFF3F1" BorderBrush="#A9BABF" BorderThickness="1" CornerRadius="12" Padding="11,7" MinWidth="188">
                                                <StackPanel><TextBlock Text="{Binding DiskTitle}" FontWeight="Bold"/><TextBlock Text="{Binding FriendlyName}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="210"/><TextBlock Text="{Binding SizeDisplay}" FontSize="11" Foreground="#526970"/></StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="DriveCard" Property="Background" Value="#D7F3E5"/><Setter TargetName="DriveCard" Property="BorderBrush" Value="#20B86A"/><Setter TargetName="DriveCard" Property="BorderThickness" Value="2"/></Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DriveCard" Property="BorderBrush" Value="#687F87"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate></Setter.Value></Setter>
                                    </Style></ListBox.ItemContainerStyle>
                                </ListBox>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" Padding="10,6"/>
                                    <Button x:Name="SelectAllButton" Content="Select All" Click="SelectAll_Click" Padding="10,6" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid></Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,13" Margin="0,0,0,10"><StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="2. Partition Layout" Margin="0,0,0,7"/>
                            <Grid x:Name="PartitionPreview" Margin="0,2" Height="62"/>
                            <TextBlock Text="Each selected disk will use a GPT partition table." Style="{StaticResource Caption}" Margin="2,4,0,0"/>
                        </StackPanel></Border>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,14" Margin="0"><Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock x:Name="WinContentTitle" Style="{StaticResource SectionTitle}" Text="3. Win11 Boot" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Text="Folders merge into the partition root." Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <ListBox x:Name="WinFoldersList" Grid.Row="2" MinHeight="72" BorderBrush="#9EB1B7" Background="#FBFCFA" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" Margin="5,3"/></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,7,0,0">
                                    <Button x:Name="WinAddFolderButton" Content="Add Folder" Click="WinAddFolder_Click" Padding="14,7"/>
                                    <Button x:Name="WinRemoveFolderButton" Content="Remove" Click="WinRemoveFolder_Click" Padding="14,7" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Row="4" Text="Autounattend.xml (optional)" FontWeight="SemiBold" Margin="0,10,0,5"/>
                                <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="UnattendSource" Style="{StaticResource Field}" TextChanged="Source_TextChanged" Padding="8,7"/>
                                    <Button x:Name="UnattendFileButton" Grid.Column="1" Content="Select XML" Click="UnattendFile_Click" Padding="8,7" Margin="8,0,0,0"/>
                                </Grid>
                            </Grid></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14" Margin="0"><Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock x:Name="ItContentTitle" Style="{StaticResource SectionTitle}" Text="4. IT Support" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Text="Folders merge into the partition root." Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <ListBox x:Name="ItFoldersList" Grid.Row="2" MinHeight="72" BorderBrush="#9EB1B7" Background="#FBFCFA" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" Margin="5,3"/></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,7,0,0">
                                    <Button x:Name="ItAddFolderButton" Content="Add Folder" Click="ItAddFolder_Click" Padding="14,7"/>
                                    <Button x:Name="ItRemoveFolderButton" Content="Remove" Click="ItRemoveFolder_Click" Padding="14,7" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid></Border>
                        </Grid>
                </Grid>

                <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,10"><StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Build Summary" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="Targets" Foreground="#526970" Margin="0,3"/><TextBlock x:Name="SummaryTarget" Grid.Column="1" Text="No USB selected" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Text="Partition style" Foreground="#526970" Margin="0,3"/><TextBlock Grid.Row="1" Grid.Column="1" Text="GPT" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Text="Data sources" Foreground="#526970" Margin="0,3"/><TextBlock x:Name="SummarySources" Grid.Row="2" Grid.Column="1" Text="0 folders, XML not set" Margin="0,3"/>
                        </Grid>
                        <Border Background="#FBE8E7" BorderBrush="#E6A7A8" BorderThickness="1" CornerRadius="12" Padding="10,8"><TextBlock Text="WARNING: Every partition and file on the selected USB drive will be permanently erased." Foreground="#8E292F" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12"/></Border>
                    </StackPanel></Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14"><Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Activity"/>
                        <ListBox x:Name="ActivityList" Grid.Row="1" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#40565D" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <ProgressBar x:Name="BuildProgress" Grid.Row="2" Height="8" Margin="0,10,0,0" Foreground="#20B86A" Background="#D9E2DF" Minimum="0" Maximum="100" Value="0"/>
                    </Grid></Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0"><StackPanel>
                        <TextBlock Text="Type ERASE to confirm" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <TextBox x:Name="ConfirmText" Style="{StaticResource Field}" CharacterCasing="Upper" TextChanged="ConfirmText_TextChanged" Margin="0,0,0,12"/>
                        <Button x:Name="BuildButton" Content="Build USB Queue" Click="Build_Click" Background="#AE3338" Height="50" FontSize="16" IsEnabled="False"/>
                    </StackPanel></Border>
                </Grid>
            </Grid>
            <TextBlock Grid.Row="2" x:Name="FooterText" Text="Administrator mode  |  Waiting for a USB drive" Foreground="#687F87" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
